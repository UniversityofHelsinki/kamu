#: kamu/forms/auth.py:311 kamu/forms/identity.py:199
msgid ""
"Invalid verification code. Please note that the verification code is "
"different from the invitation code. If you have received more than one "
"verification code, only the most recent one will be valid."
msgstr ""
"Virheellinen vahvistuskoodi. Huomioithan, että vahvistuskoodi on eri kuin "
"kutsukoodi. Jos olet lähettänyt itsellesi useamman vahvistuskoodin, vain "
"viimeisin niistä on voimassa."

#: kamu/forms/auth.py:325
msgid "Enter your phone number for SMS verification"
msgstr "Anna puhelinnumerosi tekstiviestivahvistusta varten"

#: kamu/forms/auth.py:328
msgid ""
"Enter the phone number in the international format, e.g. +358123456789. "
"Please note that we will not forward the phone number."
msgstr ""
"Anna puhelinnumero kansainvälisessä muodossa, esim. +358123456789. Huom! "
"Emme jaa puhelinnumeroa eteenpäin."

#: kamu/forms/auth.py:342
msgid "This phone number is already set by the inviter."
msgstr "Kutsuja on jo asettanut puhelinnumeron."

