#: kamu/admin/membership.py:13
msgid "Name or invite email"
msgstr "Nimi tai kutsusähköposti"

#: kamu/backends.py:148
msgid "Identifier not found."
msgstr "Tunnistetta ei löytynyt."

#: kamu/backends.py:149
msgid "Valid identifier not found. This is probably a configuration error."
msgstr ""
"Hyväksyttävää tunnistetta ei löytynyt. Kyseessä on todennäköisesti "
"määritysvirhe."

#: kamu/backends.py:150
msgid "Identifier is already linked to another user."
msgstr "Tunniste on jo linkitetty toiseen käyttäjään."

#: kamu/backends.py:151
msgid "Invalid identifier format."
msgstr "Virheellinen tunnisteen muoto."

#: kamu/backends.py:152
msgid "Could not authenticate. Please try again."
msgstr "Tunnistautuminen ei onnistunut. Ole hyvä ja yritä uudelleen."

#: kamu/backends.py:153
msgid "Identity provider is not authorised."
msgstr "Tunnistustietojen tarjoajaa ei ole hyväksytty."

#: kamu/backends.py:154
msgid "Unexpected error."
msgstr "Odottamaton virhe."

#: kamu/backends.py:155
msgid "Missing required parameters. Please try again with an another browser."
msgstr ""
"Vaadittuja tietoja puuttuu. Ole hyvä ja yritä uudelleen toisella selaimella."

#: kamu/backends.py:156 kamu/forms/auth.py:41 kamu/forms/auth.py:106
#: kamu/forms/auth.py:130
msgid "Invalid email address or phone number."
msgstr "Virheellinen sähköpostiosoite tai puhelinnumero."

#: kamu/backends.py:157 kamu/views/auth.py:127
msgid "You are already logged in."
msgstr "Olet jo kirjautunut sisään."

#: kamu/backends.py:158
msgid "User must be authenticated to link identifier."
msgstr "Käyttäjän on tunnistauduttava tunnisteen linkittämiseksi."

#: kamu/backends.py:159
msgid ""
"Staff and Superuser access is not allowed with this authentication method."
msgstr ""
"Henkilökunnan ja ylläpitäjän ei ole sallittua tunnistautua tällä "
"tunnistautumismenetelmällä."

#: kamu/backends.py:160
msgid "Role owner access is not allowed with this authentication method."
msgstr ""
"Roolin omistajan ei ole sallittua tunnistautua tällä "
"tunnistautumismenetelmällä."

#: kamu/backends.py:161
msgid "Staff and Superuser access is not allowed from this IP address."
msgstr ""
"Henkilökunnan ja ylläpitäjän ei ole sallittua tunnistautua tästä IP-"
"osoitteesta."

#: kamu/backends.py:162
msgid "You belong to a group that is not allowed from this IP address."
msgstr ""
"Kuulut ryhmään, jonka tunnistautuminen ei ole sallittua tästä IP-osoitteesta."

#: kamu/backends.py:163
msgid "Configuration error, service administrators have been notified."
msgstr "Määritysvirhe palvelussa, asiasta ilmoitettu palvelun ylläpitäjille."

#: kamu/backends.py:165
msgid ""
"Multiple identities found with the same identifier. Please contact IT "
"Helpdesk."
msgstr ""
"Useita identiteettejä löytyi samalla tunnisteella. Ota yhteyttä IT-"
"Helpdeskiin."

#: kamu/backends.py:850
msgid "Suspected duplicate user. Username already exists in the database: "
msgstr ""
"Mahdollinen duplikaattikäyttäjä. Käyttäjänimi on jo olemassa tietokannassa: "

#: kamu/backends.py:864
msgid "Suspected duplicate user. Identity already has a different username: "
msgstr "Mahdollinen duplikaattikäyttäjä. Tunnisteella on jo eri käyttäjänimi: "

