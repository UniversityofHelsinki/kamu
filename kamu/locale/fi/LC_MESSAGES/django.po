msgstr "Lähetä vahvistuskoodi tekstiviestillä"

#: kamu/forms/auth.py:359 kamu/forms/identity.py:218
msgid "Enter the verification code you received by SMS"
msgstr "Anna tekstiviestinä saamasi vahvistuskoodi"

#: kamu/forms/auth.py:370
msgid "Verify phone number"
msgstr "Vahvista puhelinnumero"

#: kamu/forms/auth.py:385 kamu/forms/identity.py:239
msgid ""
"Invalid verification code. If you sent yourself more than one verification "
"code, only the most recent one will be valid."
msgstr ""
"Virheellinen vahvistuskoodi. Jos lähetit itsellesi useamman vahvistuskoodin, "
"vain viimeisin niistä on voimassa."

