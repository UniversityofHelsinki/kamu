msgid ""
"<a target=\"_blank\" href=\"https://www.saavutettavuusvaatimukset.fi/"
"en\">www.saavutettavuusvaatimukset.fi/en</a>"
msgstr ""
"<a target=\"_blank\" href=\"https://www.saavutettavuusvaatimukset.fi/"
